{
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/VideoMobileFinale.mp4",
      "destination": "/public/VideoMobileFinale.mp4"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
